# Segredos
.env

# Configuracao pessoal do editor
.vscode/

# Ambiente Python
.venv/
__pycache__/
*.pyc


# Texto da monografia — repositorio proprio (TFC_Analise_de_Circuitos_eletronicos_IA),
# com .git e .gitignore separados. Fica de fora daqui para nao virar gitlink.
TFC/



# Saidas do LTspice: geradas ao rodar os esquematicos, nao versionadas.
simulacoes/*.raw
simulacoes/*.log
simulacoes/*.net

# As rodadas carimbadas que os scripts gravam a cada execucao: a analise
# versionada em resultados/analise e o registro, e o par de CSVs se refaz
# com reavaliar_rodada.py a partir de rodada_oficial/.
resultados/resultados_*.csv

# Log de chamadas ao OpenRouter: o cliente grava em modo append a cada
# execucao, entao versiona-lo sujaria a arvore toda vez. O registro da
# rodada oficial ja esta em rodada_oficial/openrouter_chamadas.jsonl.
resultados/openrouter_chamadas.jsonl
