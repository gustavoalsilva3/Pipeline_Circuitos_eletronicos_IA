# Modelo do arquivo de segredos. Copie para .env e preencha com as suas
# chaves. O .env fica fora do git; este arquivo, com valores de exemplo,
# e o que fica versionado, para que se saiba o que precisa ser definido.
#
# Variaveis lidas pelo codigo:
#   GEMINI_API_KEY                 -> gemini_client.py
#   OPENROUTER_API_KEY, ou Router  -> openrouter_client.py, que tenta a
#                                     primeira e usa Router se ela nao existir
GEMINI_API_KEY=sua_chave_do_google_ai_studio
Router=sua_chave_do_openrouter

# Sobras do backend local (LM Studio), que saiu da pipeline: nenhum modulo as le.
IP=endereco_do_host
LMSTUDIO_BASE_URL=http://localhost:1234
